{
  "name": "ome-music-player",
  "private": true,
  "version": "0.3.8",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:tauri": "npm run prepare:netease-runtime && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "netease:api": "NeteaseCloudMusicApi",
    "size:audit": "node scripts/size-audit.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "test": "npm run test:regression && npm run test:unit",
    "test:regression": "node scripts/regression-check.mjs",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\"",
    "tauri": "tauri",
    "prepare:netease-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-netease-runtime.ps1",
    "release:windows": "tauri build",
    "desktop": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
